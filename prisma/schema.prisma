generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Existing Kryptonal Models
// ==========================================

model article_views {
  slug  String @id
  views Int    @default(0)
}

model AirdropSubmission {
  id          String   @id @default(cuid())
  name        String
  token       String?  @default("TBA")
  platform    String
  chain       String?  @default("Unknown")
  description String
  officialUrl String
  twitterUrl  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model WhaleAlert {
  hash         String   @id
  asset        String
  amount       Float
  valueDisplay String   @map("value_display")
  fromLabel    String   @map("from_label")
  toLabel      String   @map("to_label")
  sentiment    String
  explanation  String
  network      String
  timestamp    DateTime @default(now())

  @@index([timestamp(sort: Desc)])
  @@map("whale_alerts")
}

// ==========================================
// Auth.js & Community Feed Models
// ==========================================

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  cryptoHoldEntries CryptoHoldEntry[]
  cryptoVotes       CryptoVote[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum HoldDuration {
  LONG_TERM // > 6 Months / HODL
  MONTH     // 30 Days
  WEEK      // 7 Days
  DAY       // 24 Hours / Day Trade
}

model Post {
  id            String   @id @default(cuid())
  title         String   
  slug          String   @unique
  content       String   @db.Text
  views         Int      @default(0)
  upvotes       Int      @default(0)
  trendingScore Float    @default(0.0) @map("trending_score")
  
  authorId      String   @map("author_id")
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([createdAt(sort: Desc)])
  @@index([trendingScore(sort: Desc)])
  @@map("posts")
}
model CryptoHoldEntry {
  id         String       @id @default(cuid())
  symbol     String       // e.g., "BTC", "SOL", "PEPE"
  name       String       // e.g., "Bitcoin", "Solana"
  duration   HoldDuration
  
  userId     String       @map("user_id")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime     @default(now()) @map("created_at")

  @@unique([userId, symbol, duration]) // A user can only log a specific coin once per timeframe
  @@map("crypto_hold_entries")
}

model CryptoVote {
  id         String       @id @default(cuid())
  symbol     String       // The coin voted for
  duration   HoldDuration // Category: LONG_TERM, MONTH, WEEK, DAY
  
  userId     String       @map("user_id")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt  DateTime     @default(now()) @map("created_at")

  @@unique([userId, duration]) // A user gets 1 vote per duration category cycle
  @@map("crypto_votes")
}
model tool_usage {
  slug  String @id
  views Int    @default(0)
}