generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model article_views {
  slug  String @id
  views Int    @default(0)
}

model AirdropSubmission {
  id          String   @id @default(cuid())
  name        String
  token       String?  @default("TBA")
  platform    String
  chain       String?  @default("Unknown")
  description String
  officialUrl String
  twitterUrl  String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model WhaleAlert {
  hash         String   @id
  asset        String
  amount       Float
  valueDisplay String   @map("value_display")
  fromLabel    String   @map("from_label")
  toLabel      String   @map("to_label")
  sentiment    String
  explanation  String
  network      String
  timestamp    DateTime @default(now())

  @@index([timestamp(sort: Desc)])
  @@map("whale_alerts")
}
